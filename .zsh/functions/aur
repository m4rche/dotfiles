aur() {
    local pkg="$1"

    sudo -v

    if [[ ! -d "$HOME/.aur" ]]; then
        echo "Error: $HOME/.aur does not exist"
        return 1
    fi

    local dir=$(find "$HOME/.aur" -maxdepth 1 -iname "*$pkg*" -print -quit 2>/dev/null)
    if [[ ! -d "$dir" ]]; then
        echo "Cloning $pkg..."
        dir="$HOME/.aur/$pkg"
        git clone --branch "$pkg" --single-branch https://github.com/archlinux/aur.git "$HOME/.aur/$pkg"
    else
        pkg=$(basename "$dir")
        echo "Found $pkg, pulling latest..."
        git -C "$dir" pull origin "$pkg"
    fi

    makepkg --dir "$dir" --syncdeps --rmdeps --clean
    sudo pacman --noconfirm -U "$dir"/$pkg*.zst

    rm -vf "$dir"/*.zst "$dir"/*.deb
}
